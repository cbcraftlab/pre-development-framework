{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-context",
  "type": "object",
  "properties": {
    "framework_version": {
      "type": "string",
      "enum": [
        "0.10.0-candidate.1",
        "0.10.0-candidate.2"
      ]
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "assignment_policy": {
      "type": "string",
      "enum": [
        "fixed",
        "propose_changes"
      ]
    },
    "hard_constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "preferences": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "team": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "member_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "confirmed_responsibilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "availability": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "member_id",
          "confirmed_responsibilities",
          "availability",
          "capabilities"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "suggested_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "member_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "proposal": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "member_id",
          "proposal",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "framework_version",
    "project_id",
    "assignment_policy",
    "hard_constraints",
    "preferences",
    "team",
    "suggested_changes",
    "unknowns"
  ],
  "additionalProperties": false
}
