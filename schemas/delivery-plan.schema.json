{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delivery-plan",
  "type": "object",
  "properties": {
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "acceptance_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "statement",
          "source_ids",
          "acceptance_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "criterion": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "method": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "criterion",
          "method"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "owner": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "proposed",
              "confirmed"
            ]
          },
          "definition": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "owner",
          "state",
          "definition",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "objective": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "non_goals": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "acceptance_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "contracts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "owner": {
            "type": "string"
          },
          "responsibility": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "collaborators": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "slice_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "title",
          "objective",
          "scope",
          "non_goals",
          "requirements",
          "acceptance_ids",
          "contracts",
          "depends_on",
          "owner",
          "responsibility",
          "collaborators",
          "slice_id"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "slices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "task_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "readiness": {
            "type": "string",
            "enum": [
              "not_assessed",
              "ready",
              "conditionally_ready",
              "not_ready",
              "invalid_input"
            ]
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "owner": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "decision_by": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "isolation": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "invalidated_tasks": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "high_consequence": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "owner",
                "decision_by",
                "isolation",
                "invalidated_tasks",
                "high_consequence"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "authorized": {
            "type": "boolean"
          },
          "approval": {
            "type": "object",
            "properties": {
              "approved_by": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "approved_at": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "approved_package_version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "approved_by",
              "approved_at",
              "evidence",
              "approved_package_version"
            ],
            "additionalProperties": false
          },
          "integration_owner": {
            "type": "string"
          },
          "acceptance_owner": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "task_ids",
          "readiness",
          "blockers",
          "conditions",
          "authorized",
          "integration_owner",
          "acceptance_owner"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "added",
              "changed",
              "removed",
              "unchanged"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "before": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "after": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "affected_tasks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "kind",
          "id",
          "before",
          "after",
          "affected_tasks"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "requirements",
    "acceptance",
    "contracts",
    "tasks",
    "slices",
    "changes"
  ],
  "additionalProperties": false
}
