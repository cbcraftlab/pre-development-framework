{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quick-input",
  "type": "object",
  "required": ["project_id", "package_id", "package_slug", "title", "goal", "scope", "non_goals", "acceptance"],
  "properties": {
    "project_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "package_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"},
    "package_slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "goal": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
    "non_goals": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
    "acceptance": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["criterion", "method"], "additionalProperties": false,
        "properties": {"criterion": {"type": "string", "minLength": 1, "pattern": "\\S"}, "method": {"type": "string", "minLength": 1, "pattern": "\\S"}}}
    },
    "team": {"type": "array", "items": {"type": "object"}},
    "owner": {"type": "string"}
  },
  "additionalProperties": false
}
